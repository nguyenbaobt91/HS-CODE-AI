 <tr>
  <td width="6%" rowspan=3 valign=top style='width:6.56%;border:solid windowtext 1.0pt;
  border-top:none;padding:0cm 0cm 0cm 0cm'>
  <p align=center style='margin-top:6.0pt;text-align:center;text-autospace:
  none'><span style='sans-serif'><span style='font-size:9.0pt'>3.3.6</span></span></p>
  </td>
  <td width="17%" rowspan=3 valign=top style='width:17.72%;border-top:none;
  border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 0cm 0cm 0cm'>
  <p style='margin-top:6.0pt;text-autospace:none'><span style='sans-serif'><span
  style='font-size:9.0pt'>Phao chỉ báo vị trí cá nhân hoạt động trên băng tần
  406,0 MHz đến 406,1 MHz</span></span></p>
  </td>
  <td width="18%" rowspan=3 valign=top style='width:18.5%;border-top:none;
  border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;
  padding:0cm 0cm 0cm 0cm'>
  <p style='margin-top:6.0pt;text-autospace:none'><span style='sans-serif'><a
  name="tvpllink_iujncxurah"><span style='font-size:9.0pt'>QCVN 108:2016/BTTTT</span></span></a></p>
  <p style='margin-top:6.0pt;text-autospace:none'><span style='sans-serif'><a
  name="tvpllink_wovqlvlbpm_23"><span style='font-size:9.0pt'>QCVN 47:2015/BTTTT</span></span></a></p>
