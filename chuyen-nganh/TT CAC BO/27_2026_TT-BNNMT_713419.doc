  border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:0cm 0cm 0cm 0cm'>
  <p style='margin-top:6.0pt'><span style='sans-serif'>&nbsp;</span></p>
  </td>
 </tr>
 <tr>
  <td width="6%" style='width:6.74%;border:solid black 1.0pt;border-top:none;
  padding:0cm 0cm 0cm 0cm'>
  <p align=center style='margin-top:6.0pt;text-align:center'><span
  style='sans-serif'>&nbsp;</span></p>
  </td>
  <td width="31%" style='width:31.9%;border-top:none;border-left:none;
  border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:0cm 0cm 0cm 0cm'>
  <p style='margin-top:6.0pt'><span style='sans-serif'>Sắn, củ dong, củ lan,
  a-ti-sô Jerusalem, khoai lang và các loại củ và rễ tương tự có hàm lượng tinh
  bột hoặc inulin cao, tươi, ướp lạnh, đông lạnh hoặc khô, đã hoặc chưa thái
  lát hoặc làm thành dạng viên; lõi cây cọ sago</span></p>
  </td>
  <td width="9%" style='width:9.66%;border-top:none;border-left:none;
  border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:0cm 0cm 0cm 0cm'>
  <p align=center style='margin-top:6.0pt;text-align:center'><span
  style='sans-serif'>07.14</span></p>
  </td>
  <td width="24%" style='width:24.16%;border-top:none;border-left:none;
  border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:0cm 0cm 0cm 0cm'>
  <p style='margin-top:6.0pt'><span style='sans-serif'>&nbsp;</span></p>
  </td>
  <td width="27%" style='width:27.54%;border-top:none;border-left:none;
  border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;padding:0cm 0cm 0cm 0cm'>
  <p style='margin-top:6.0pt'><span style='sans-serif'>&nbsp;</span></p>
  </td>
 </tr>
 <tr>
  <td width="6%" style='width:6.74%;border:solid black 1.0pt;border-top:none;
  padding:0cm 0cm 0cm 0cm'>
  <p align=center style='margin-top:6.0pt;text-align:center'><span
  style='sans-serif'>&nbsp;</span></p>
  </td>
