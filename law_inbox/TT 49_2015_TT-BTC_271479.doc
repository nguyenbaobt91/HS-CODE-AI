<table border=0 cellspacing=0 cellpadding=0
 style='border-collapse:collapse'><!--VABWAFAATABfADIAMAAyADYAMQAwADAANQA=-->
 <tr style='height:.05pt'>
  <td width=233 valign=top style='width:174.6pt;background:white;padding:0cm 5.4pt 0cm 5.4pt;
  height:.05pt'>
  <p align=center style='margin-bottom:6.0pt;text-align:center;
  text-autospace:none'><b>&nbsp;</b></p>
  <p align=center style='margin-bottom:6.0pt;text-align:center;
  text-autospace:none'><b>CÔNG CHỨC HẢI QUAN <br>
  </b><i>(Ký, đóng dấu công chức)</i><b> </b></p>
  </td>
  <td width=360 valign=top style='width:270.0pt;background:white;padding:0cm 5.4pt 0cm 5.4pt;
  height:.05pt'>
  <p align=center style='margin-bottom:6.0pt;text-align:center;
  text-autospace:none'><i>….. ngày ….. tháng ….. năm ………</i></p>
