  padding:2.25pt 2.25pt 2.25pt 2.25pt'>
  <p style='margin-top:6.0pt'>Công nghệ kỹ thuật hóa học</p>
  </td>
 </tr>
 <tr>
  <td width="22%" style='width:22.66%;border:solid windowtext 1.0pt;border-top:
  none;padding:2.25pt 2.25pt 2.25pt 2.25pt'>
  <p align=center style='margin-top:6.0pt;text-align:center'>5510402</p>
  </td>
  <td width="77%" style='width:77.34%;border-top:none;border-left:none;
